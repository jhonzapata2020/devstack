# ==============================================================================
# UNAD DevTrack - Reglas de Exclusión de Git (.gitignore)
# Ciberseguridad: Blindaje estricto de credenciales y secretos
# ==============================================================================

# Credenciales y archivos de entorno (CRÍTICO)
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Dependencias
/node_modules
/.pnp
.pnp.js

# Entornos de compilación y empaquetado (Next.js)
/.next/
/out/
/build
/dist

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Pruebas y cobertura
/coverage

# Archivos de sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts
