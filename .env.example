# ==============================================================================
# UNAD DevTrack - Plantilla de Variables de Entorno
# ATENCIÓN: NUNCA expongas claves reales en este archivo.
# Copia este archivo como '.env.local' y asigna las credenciales de tu proyecto.
# ==============================================================================

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Anon / Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_publishable_anon_key_aqui

# Clave de servicio para entornos backend protegidos (Opcional en cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
